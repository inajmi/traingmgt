# ---------------------------------------------------------------------------
# Trainer Tracker environment.
# Copy to server/.env and adjust. Only DATABASE_URL and JWT_SECRET are required.
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://trainer:trainer_dev_pass@127.0.0.1:5432/trainer_tracker"

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=3000
APP_BASE_URL="http://localhost:3000"
APP_TZ="Asia/Dubai"

# Bootstrap admin account for `npm run create:admin`.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"

# Optional SMTP channel. The app runs fully without these (in-app messaging only).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@example.com"