{
  "name": "trainer-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Trainer Tracker — multi-user trainer management app (admin portal, trainer profiles, availability, training calendar, in-app messaging).",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c green,blue \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "create:admin": "npm run create:admin -w server"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.5",
    "concurrently": "^9.2.4"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  }
}
